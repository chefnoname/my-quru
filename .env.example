# Copy this file to .env.local and fill in what you need. All three are optional.

# Where the sign-up form POSTs its answers (for example a Formspree, Basin or Zapier webhook address).
# While it is empty the page is a design preview: the form sends nothing and a strip at the top says so.
NEXT_PUBLIC_FORM_ENDPOINT=

# Shown on the thank-you panel after a sister signs up.
NEXT_PUBLIC_CONTACT_EMAIL=

# "true" for a copy to show investors: no preview strip, and the thank-you panel shows, though nothing is saved.
NEXT_PUBLIC_SHOWCASE=
