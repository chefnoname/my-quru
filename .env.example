# Copy this file to .env.local and fill in what you need. All three are optional.

# The Formspree form the sign-up answers go to, like https://formspree.io/f/xxxxxxxx
# While it is empty the form sends nothing, and the thank-you panel says it was a preview.
NEXT_PUBLIC_FORM_ENDPOINT=

# Shown on the thank-you panel after a sister signs up.
NEXT_PUBLIC_CONTACT_EMAIL=

# "true" for a copy to show investors: the thank-you panel shows without the preview note, though nothing is saved.
NEXT_PUBLIC_SHOWCASE=
