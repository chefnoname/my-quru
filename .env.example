# Copy this file to .env.local if you need to change a setting. None are needed: by default sign-ups go to
# Quru's Formspree form.

# Where the answers go: another https://formspree.io/f/... address, or "off" for a preview that sends nothing.
# NEXT_PUBLIC_FORM_ENDPOINT=off

# Shown on the thank-you panel after a sister signs up.
# NEXT_PUBLIC_CONTACT_EMAIL=

# "true" for a copy to show investors: the form never sends, and the thank-you panel shows without a preview note.
# NEXT_PUBLIC_SHOWCASE=true

# Microsoft Clarity: heatmaps and session replays. By default, Quru's project (zeqcdd2y9f). Another project ID,
# or "off" for no analytics (for example on a local preview).
# NEXT_PUBLIC_CLARITY_ID=off
